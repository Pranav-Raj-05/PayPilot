# ===== Backend (backend/.env) - SECRETS, never commit real values, never prefix with VITE_ =====
APP_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=                      # optional extra origins, comma separated

# Supabase Postgres connection string (Project Settings > Database > Connection string). Use a role that owns the tables.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret     # Project Settings > API > JWT Secret (HS256). RS256/ES256 projects use SUPABASE_URL JWKS.

# PayPal (primary). Sandbox: https://api-m.sandbox.paypal.com   Live: https://api-m.paypal.com
PAYPAL_CLIENT_ID=BAA_ByJRAFfSeSJOLxPirNV9N4o8H7DFqc6GPvmnDXu08oio_fvmx5xY52K0q3nbB2vRWEvfVrWklQiuFY
PAYPAL_CLIENT_SECRET=EMlaPxIwLiVAVUMKU7ztIvsyEBWyi4kfKBxRpCAMR1wG9lCcRoC9Zt2x4HXFjtQvcJQou-wEbvNL7Y2n
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# Razorpay (optional, test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# AI: gemini | openai
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

